.claude/settings.local.json

# Claude Code scratch worktrees (created by Agent isolation:"worktree" runs, not project source)
.claude/worktrees/

# Unrelated tool config accidentally left at repo root (not part of this project)
.freebuff/

# Node / build
node_modules/
dist/
*.local

# Environment variables and other local secrets — never commit real key values
# (see CLAUDE.md's "Never put a real secret key..." rule). GEMINI_API_KEY lives
# only as a Vercel environment variable, not in any file here.
.env
.env.*
!.env.example

# Vercel CLI local project link/config (created by `vercel login`/`vercel link`)
.vercel

# Firebase service-account / admin SDK keys, should one ever be added later
# (Sprint 13 deliberately avoided needing one — see api/smart-capture.ts)
serviceAccountKey.json
*-firebase-adminsdk-*.json

# Generic private-key/certificate file extensions
*.pem
*.key
*.p12
*.pfx

# Firestore Emulator debug log (generated by `npm run test:rules`)
firestore-debug.log

# Obsidian workspace config at repo root (not the vault's own .docs/.obsidian/, which is tracked)
/.obsidian/
