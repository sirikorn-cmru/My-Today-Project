rules_version = '2';

// Sprint 12 (Version 3, Cloud Sync): every synced document lives under
// users/{uid}/{collection}/{id} (Business Rule 6) — a user may only read or
// write documents under their own uid, never another user's (Business Rule 7).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
